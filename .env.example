# ==============================================================================
# Zabbix MCP Server - Configuração de Variáveis de Ambiente
# ==============================================================================

# Conexão com o Zabbix Server
ZABBIX_URL=http://192.168.0.107:8080/api_jsonrpc.php
ZABBIX_TOKEN=3752dc4ae3d95027e4ce06e1ed28b2ba57f4e7902357b7eb9e2dae109bf02d45

# Autenticação legada (caso token de API não seja utilizado)
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# Controle de Acesso Baseado em Funções (RBAC)
# Modos disponíveis: somente_leitura (padrão seguro), operacional, administrativo
ZABBIX_MCP_MODE=somente_leitura

# Segurança e Confirmação em Dois Passos
ZABBIX_REQUIRE_APPROVAL_DESTRUCTIVE=true
ZABBIX_APPROVAL_TOKEN_SECRET=altere-esta-chave-secreta-em-producao-para-uma-string-aleatoria-forte

# Timeouts e Conectividade
ZABBIX_TIMEOUT=30.0
ZABBIX_VERIFY_SSL=true
ZABBIX_MAX_RETRIES=3
ZABBIX_BACKOFF_FACTOR=0.5
ZABBIX_MAX_CONCURRENCY=10
ZABBIX_PAGE_SIZE=100

# Armazenamento de Arquivos
ZABBIX_REPORTS_DIR=./reports_output
ZABBIX_AUDIT_LOG_PATH=./audit_mcp.jsonl
